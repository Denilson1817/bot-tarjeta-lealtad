# Copia este archivo como .env y completa los valores (el .env no se versiona).

# Token del bot de @BotFather (en local, el bot de PRUEBAS)
BOT_TOKEN=

# ID numérico de Telegram del dueño
OWNER_ID=

# Zona horaria del negocio (nombre IANA, distingue mayúsculas)
ZONA_HORARIA=America/Mexico_City

# Citas por tarjeta: 9 flores + la cita de premio
CITAS_POR_TARJETA=10

# Opcionales (estos son los valores por defecto)
# DB_PATH=data/lealtad.db
# LOG_LEVEL=INFO
